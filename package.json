{
  "name": "codex-local-figma-mcp-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local MCP bridge for Codex-driven editing of open Figma drafts.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && npm run build:plugin",
    "build:plugin": "node esbuild.config.mjs",
    "dev:mcp": "tsx src/mcp/server.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.1",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@figma/plugin-typings": "^1.114.0",
    "@types/node": "^24.1.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.8",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
